        <!-- 说明框 -->
        <mxCell id="note1" value="&lt;b&gt;关键优势:&lt;/b&gt;&lt;br&gt;• 串口与协议解耦&lt;br&gt;• 支持运行时切换协议&lt;br&gt;• 易于添加自定义引擎&lt;br&gt;• 统一的解析接口" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e1f5fe;strokeColor=#0288d1;size=16;fontSize=11;align=left;" vertex="1" parent="1">
