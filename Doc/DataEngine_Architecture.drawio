        <!-- 总结框 -->
        <mxCell id="summary2" value="&lt;h3&gt;新架构流程对比&lt;/h3&gt;&lt;hr&gt;&lt;p style=&quot;text-align:left&quot;&gt;&lt;b&gt;旧架构:&lt;/b&gt; SerialThread内部耦合解析逻辑&lt;br&gt;&lt;b&gt;新架构:&lt;/b&gt; 引擎独立，SerialThread只负责调用&lt;br&gt;&lt;br&gt;&lt;b&gt;优势:&lt;/b&gt;&lt;br&gt;• 协议解析逻辑完全独立&lt;br&gt;• 支持运行时切换协议&lt;br&gt;• 添加新协议无需修改SerialThread&lt;br&gt;• 每个引擎一个文件，易于维护&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e1f5fe;strokeColor=#0288d1;size=16;align=center;fontSize=11;" vertex="1" parent="seq2-1">
          <mxGeometry x="80" y="980" width="400" height="180" as="geometry" />
        </mxCell>

        <mxCell id="highlight2" value="&lt;b&gt;关键改进点&lt;/b&gt;&lt;br&gt;引擎返回 ParseResult，包含:&lt;br&gt;• consumed_bytes: 清理buffer&lt;br&gt;• data: 解析结果&lt;br&gt;• success: 是否成功&lt;br&gt;• error_message: 错误信息" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9e6;strokeColor=#f9a825;size=16;align=left;fontSize=10;" vertex="1" parent="seq2-1">
          <mxGeometry x="560" y="980" width="260" height="120" as="geometry" />
        </mxCell>

