<mxfile host="app.diagrams.net">
  <diagram name="新架构类图 - New Architecture" id="new-class-diagram">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="&lt;h1&gt;数据引擎架构 - 新设计&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- BaseDataEngine 抽象类 -->
        <mxCell id="base-engine" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;BaseDataEngine&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- channel_count: int&lt;br&gt;- config: Dict&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ &lt;i&gt;parse(buffer): ParseResult&lt;/i&gt;&lt;br&gt;+ &lt;i&gt;get_name(): str&lt;/i&gt;&lt;br&gt;+ &lt;i&gt;get_description(): str&lt;/i&gt;&lt;br&gt;+ get_channel_names(): List[str]&lt;br&gt;+ get_config_schema(): Dict&lt;br&gt;+ reset(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#e1bee7;strokeColor=#9c27b0;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- ParseResult 数据类 -->
        <mxCell id="parse-result" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;&amp;lt;&amp;lt;dataclass&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;ParseResult&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ success: bool&lt;br&gt;+ data: Dict[str, Union[float, str]]&lt;br&gt;+ consumed_bytes: int&lt;br&gt;+ error_message: Optional[str]&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="280" height="110" as="geometry" />
        </mxCell>

        <!-- FireWaterEngine -->
        <mxCell id="firewater-engine" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;FireWaterEngine&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- TAIL_BYTE = b'\n'&lt;br&gt;- encoding: str&lt;br&gt;- max_packet_size: int&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ parse(buffer): ParseResult&lt;br&gt;+ get_name(): &quot;firewater&quot;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#c5e1a5;strokeColor=#7cb342;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- JustFloatEngine -->
        <mxCell id="justfloat-engine" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;JustFloatEngine&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- FLOAT_SIZE = 4&lt;br&gt;- byte_order: str&lt;br&gt;- packet_size: int&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ parse(buffer): ParseResult&lt;br&gt;+ get_name(): &quot;justfloat&quot;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#c5e1a5;strokeColor=#7cb342;" vertex="1" parent="1">
          <mxGeometry x="480" y="270" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- ASCIIEngine -->
        <mxCell id="ascii-engine" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ASCIIEngine&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- encoding: str&lt;br&gt;- batch_size: int&lt;br&gt;- decode_errors: str&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ parse(buffer): ParseResult&lt;br&gt;+ get_name(): &quot;ascii&quot;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#c5e1a5;strokeColor=#7cb342;" vertex="1" parent="1">
          <mxGeometry x="480" y="440" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- CustomEngine (用户自定义) -->
        <mxCell id="custom-engine" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;CustomEngine&lt;/b&gt;&lt;br&gt;(用户自定义)&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;自定义字段...&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ parse(buffer): ParseResult&lt;br&gt;+ get_name(): &quot;custom&quot;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#b2dfdb;strokeColor=#00695c;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="610" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- DataEngineManager -->
        <mxCell id="engine-manager" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;DataEngineManager&lt;/b&gt;&lt;br&gt;(Singleton)&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- _engine_classes: Dict[str, Type]&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ register_engine(class): bool&lt;br&gt;+ create_engine(name, **config): Engine&lt;br&gt;+ get_available_engines(): List[Dict]&lt;br&gt;+ get_engine_names(): List[str]&lt;br&gt;+ _load_custom_engines(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#ffccbc;strokeColor=#ff6f00;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="300" height="170" as="geometry" />
        </mxCell>

        <!-- SerialThread (新版) -->
        <mxCell id="serial-thread-new" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;SerialThread&lt;/b&gt;&lt;br&gt;(重构版)&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- engine: BaseDataEngine&lt;br&gt;- serial_port: Serial&lt;br&gt;- buffer: bytearray&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ run(): void&lt;br&gt;+ _process_data(data): void&lt;br&gt;+ set_engine(name, config): bool&lt;br&gt;+ get_engine_info(): Dict&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;«signal» data_received(dict)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="360" width="300" height="200" as="geometry" />
        </mxCell>

        <!-- SerialManager -->
        <mxCell id="serial-manager-new" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;SerialManager&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- serial_thread: SerialThread&lt;br&gt;- channel_manager: ChannelManager&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ connect(port, ...): bool&lt;br&gt;+ _on_data_received(data): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="620" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- ChannelManager -->
        <mxCell id="channel-manager-new" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ChannelManager&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- current_values: Dict&lt;br&gt;- history: Dict&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ update_batch(data): void&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;«signal» batch_updated(dict)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1200" y="620" width="220" height="120" as="geometry" />
