            <mxPoint x="325" y="590" as="targetPoint" />
            <Array as="points">
              <mxPoint x="400" y="560" />
              <mxPoint x="400" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 发射信号 -->
        <mxCell id="step2-7" value="7. «signal» data_received(data)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="seq2-1" source="act2-1" target="seq2-serial-manager">
          <mxGeometry width="80" relative="1" as="geometry">
            <mxPoint x="325" y="640" as="sourcePoint" />
