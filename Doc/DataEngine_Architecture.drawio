        <!-- 继承关系 -->
        <mxCell id="inherit1" value="" style="endArrow=block;endFill=0;endSize=12;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="firewater-engine" target="base-engine">
