        <!-- Widget更新 -->
        <mxCell id="step2-11" value="11. _on_data_update(data)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=1;exitY=0.2;entryX=1;entryY=0.7;" edge="1" parent="seq2-1">
          <mxGeometry relative="1" as="geometry">
