  <diagram name="数据流序列图 - New Flow" id="new-sequence">
    <mxGraphModel dx="1422" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="seq2-0" />
        <mxCell id="seq2-1" parent="seq2-0" />

        <!-- 标题 -->
        <mxCell id="seq2-title" value="&lt;h1&gt;新架构数据流序列图&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="seq2-1">
          <mxGeometry x="450" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- 生命线 -->
        <mxCell id="seq2-serial-port" value="串口设备" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="seq2-1">
          <mxGeometry x="80" y="100" width="100" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="seq2-serial-thread" value="SerialThread" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="seq2-1">
          <mxGeometry x="260" y="100" width="120" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="seq2-engine" value="DataEngine\n(FireWater)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#c5e1a5;strokeColor=#7cb342;" vertex="1" parent="seq2-1">
          <mxGeometry x="460" y="100" width="140" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="seq2-serial-manager" value="SerialManager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="seq2-1">
          <mxGeometry x="680" y="100" width="130" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="seq2-channel-manager" value="ChannelManager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="seq2-1">
          <mxGeometry x="900" y="100" width="140" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="seq2-widget" value="BaseWidget" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="seq2-1">
          <mxGeometry x="1120" y="100" width="120" height="1000" as="geometry" />
        </mxCell>

        <!-- 激活条 -->
        <mxCell id="act2-1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="seq2-1">
          <mxGeometry x="315" y="200" width="10" height="800" as="geometry" />
        </mxCell>

        <!-- 步骤1: 接收数据 -->
        <mxCell id="step2-1" value="1. 读取串口数据" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" edge="1" parent="seq2-1" source="seq2-serial-port" target="act2-1">
          <mxGeometry width="80" relative="1" as="geometry">
            <mxPoint x="130" y="200" as="sourcePoint" />
            <mxPoint x="315" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note2-1" value="原始字节流" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e1f5fe;strokeColor=#0288d1;size=10;fontSize=9;" vertex="1" parent="seq2-1">
          <mxGeometry x="40" y="220" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- 步骤2: 添加到buffer -->
        <mxCell id="step2-2" value="2. buffer.extend(data)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=1;exitY=0.05;entryX=1;entryY=0.08;" edge="1" parent="seq2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="280" as="sourcePoint" />
            <mxPoint x="325" y="320" as="targetPoint" />
            <Array as="points">
              <mxPoint x="400" y="280" />
              <mxPoint x="400" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 步骤3: 调用引擎解析 -->
        <mxCell id="step2-3" value="3. engine.parse(buffer)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0.15;" edge="1" parent="seq2-1" source="act2-1" target="seq2-engine">
          <mxGeometry width="80" relative="1" as="geometry">
            <mxPoint x="325" y="360" as="sourcePoint" />
            <mxPoint x="530" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="act2-2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#c5e1a5;strokeColor=#7cb342;" vertex="1" parent="seq2-1">
          <mxGeometry x="525" y="360" width="10" height="160" as="geometry" />
        </mxCell>

        <!-- 引擎内部处理 -->
        <mxCell id="step2-4" value="4. 解析协议\n(查找'\n', split(','), 转float)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=1;exitY=0.2;entryX=1;entryY=0.6;" edge="1" parent="seq2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="390" as="sourcePoint" />
            <mxPoint x="535" y="460" as="targetPoint" />
            <Array as="points">
              <mxPoint x="620" y="390" />
              <mxPoint x="620" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 返回ParseResult -->
        <mxCell id="step2-5" value="5. return ParseResult\n(success, data, consumed_bytes)" style="html=1;verticalAlign=bottom;endArrow=return;exitX=0;exitY=0.9;entryX=1;entryY=0.25;" edge="1" parent="seq2-1" source="act2-2" target="act2-1">
          <mxGeometry width="80" relative="1" as="geometry">
            <mxPoint x="525" y="504" as="sourcePoint" />
            <mxPoint x="325" y="504" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note2-2" value="ParseResult:\n{\n  success: True,\n  data: {I0: 1.23, I1: 4.56},\n  consumed_bytes: 14\n}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9e6;strokeColor=#f9a825;size=10;fontSize=9;align=left;" vertex="1" parent="seq2-1">
          <mxGeometry x="380" y="480" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- 清理buffer -->
        <mxCell id="step2-6" value="6. buffer = buffer[consumed_bytes:]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=1;exitY=0.35;entryX=1;entryY=0.4;" edge="1" parent="seq2-1">
          <mxGeometry relative="1" as="geometry">
