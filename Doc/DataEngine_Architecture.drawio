          <mxGeometry x="740" y="640" width="10" height="300" as="geometry" />
        </mxCell>

        <!-- SerialManager转发 -->
        <mxCell id="step2-8" value="8. _on_data_received(data)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0.6;" edge="1" parent="seq2-1" source="act2-3" target="seq2-channel-manager">
          <mxGeometry width="80" relative="1" as="geometry">
