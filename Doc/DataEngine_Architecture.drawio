        <!-- 发射batch_updated -->
        <mxCell id="step2-10" value="10. «signal» batch_updated(data)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0.8;dashed=1;" edge="1" parent="seq2-1" source="act2-4" target="seq2-widget">
          <mxGeometry width="80" relative="1" as="geometry">
