        <mxCell id="note2" value="&lt;b&gt;自定义引擎加载:&lt;/b&gt;&lt;br&gt;1. 放入 custom/ 目录&lt;br&gt;2. 继承 BaseDataEngine&lt;br&gt;3. 实现 parse() 方法&lt;br&gt;4. 自动加载，无需修改代码" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9e6;strokeColor=#f9a825;size=16;fontSize=11;align=left;" vertex="1" parent="1">
