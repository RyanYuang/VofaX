        <!-- ChannelManager更新 -->
        <mxCell id="step2-9" value="9. update_batch(data)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;exitX=1;exitY=0.1;entryX=1;entryY=0.3;" edge="1" parent="seq2-1">
